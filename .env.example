# Copy this file to .env.local and fill in the values from your Supabase project:
# Supabase dashboard → Project Settings → API Keys (and Data API for the URL).
# .env.local is git-ignored; never commit real keys.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts sb_publishable_). Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts sb_secret_). Server only: bypasses row-level security.
SUPABASE_SECRET_KEY=

# Stripe (test keys first). Secret key: Stripe → Developers → API keys.
# Webhook secret: from the endpoint for /api/stripe/webhook (events: checkout.session.completed,
# checkout.session.async_payment_succeeded, customer.subscription.updated, customer.subscription.deleted).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email alerts (optional): resend.com → API Keys. Without it the site sends no email.
# With Resend's test sender (the default) alerts can only go to the email your Resend account uses.
RESEND_API_KEY=
# After verifying tapfolio.co.uk in Resend you can send from your own address, e.g.
# EMAIL_FROM=Tapfolio <orders@tapfolio.co.uk>

# Comma-separated emails allowed into /admin. The first one also gets order alerts.
ADMIN_EMAILS=
